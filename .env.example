# Auckland Transport subscription key (enter yourself; never commit)
AT_SUBSCRIPTION_KEY=CHANGEME

# Realtime endpoints (legacy)
AT_VEHICLE_LOCATIONS_URL=https://api.at.govt.nz/realtime/legacy/vehiclelocations
AT_TRIP_UPDATES_URL=https://api.at.govt.nz/realtime/legacy/tripupdates
AT_SERVICE_ALERTS_URL=https://api.at.govt.nz/realtime/legacy/servicealerts

# Static GTFS
GTFS_ZIP_URL=https://gtfs.at.govt.nz/gtfs.zip
GTFS_ZIP_PATH=./data/gtfs.zip

# Optional AT GTFS REST routes endpoint (subscription product dependent)
AT_GTFS_ROUTES_URL=

# Config
REFRESH_INTERVAL_SECONDS=30
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
EOF
